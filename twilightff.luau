do
    local Lib = ah
    local Players = game:GetService("Players")

    ---------------------------------------------------------------------
    -- 1. Object ESP: automatic cleanup
    ---------------------------------------------------------------------
    local objectConns = setmetatable({}, { __mode = "k" }) -- [object] = { connections }

    local function kill(drawing)
        if drawing then
            pcall(function() drawing:Remove() end)
            pcall(function() drawing:Destroy() end)
        end
    end

    local function killAll(tbl)
        if type(tbl) == "table" then
            for _, drawing in pairs(tbl) do kill(drawing) end
        end
    end

    local function removeObjectESP(esp, lib)
        lib = type(lib) == "table" and lib or Lib
        if rawget(esp, "_removed") then return end
        esp._removed = true

        local object = esp.object
        local conns = objectConns[object]
        if conns then
            objectConns[object] = nil
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        end

        killAll(esp.Box)
        killAll(esp.HealthBar)
        killAll(esp.Info)
        killAll(esp.Fills)
        kill(esp.Tracer)
        kill(esp.Snapline)
        if esp.highlight then pcall(function() esp.highlight:Destroy() end) end

        local store = lib.ObjectESPs
        if store then
            if store.ESPs then store.ESPs[object] = nil end
            if store.Highlights then store.Highlights[object] = nil end
        end
    end

    local function patchClass(esp)
        local class = getmetatable(esp)
        if type(class) == "table" and not rawget(class, "__twilightPatched") then
            class.__twilightPatched = true
            class.RemoveESP = removeObjectESP -- esp:RemoveESP(Twilight) now works properly
        end
    end

    local function watch(object, esp)
        local conns = {}
        objectConns[object] = conns

        table.insert(conns, object.AncestryChanged:Connect(function()
            if not object:IsDescendantOf(workspace) then removeObjectESP(esp, Lib) end
        end))
        table.insert(conns, object.Destroying:Connect(function()
            removeObjectESP(esp, Lib)
        end))

        local root = esp.rootPart
        if root and root ~= object then
            table.insert(conns, root.AncestryChanged:Connect(function()
                if not root:IsDescendantOf(object) then removeObjectESP(esp, Lib) end
            end))
        end
    end

    local originalBind = Lib.BindESPToObject
    function Lib:BindESPToObject(object, rootPart)
        local store = Lib.ObjectESPs
        local existing = store and store.ESPs and store.ESPs[object]
        if existing then return existing end -- already bound: no duplicates

        local esp = originalBind(self, object, rootPart)
        if esp then
            patchClass(esp)
            watch(object, esp)
        end
        return esp
    end

