        return Players:GetPlayerFromCharacter(model) == nil
    end

    local function findRoot(object)
        if object:IsA("BasePart") then return object end
        local root = object:FindFirstChild("HumanoidRootPart")
        if not root and object:FindFirstChildOfClass("Humanoid") then
            root = object:WaitForChild("HumanoidRootPart", 3)
        end
        return root or object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")
    end

    -- options (all optional): { Recursive = false, Filter = function(child) return true/false end }
    function Lib:BindESPToFolder(folder, options)
        options = options or {}
        local filter = options.Filter or isNPC
        local recursive = options.Recursive == true

        local function consider(child)
            task.spawn(function()
                local store = Lib.ObjectESPs
                if store and store.ESPs and store.ESPs[child] then return end
                local ok, pass = pcall(filter, child)
                if not ok or not pass then return end
                local root = findRoot(child)
                if not root or not child:IsDescendantOf(workspace) then return end
                Lib:BindESPToObject(child, root)
            end)
        end

        for _, child in ipairs(recursive and folder:GetDescendants() or folder:GetChildren()) do
            consider(child)
        end

        local signal = recursive and folder.DescendantAdded or folder.ChildAdded
        local connection = signal:Connect(consider)
        table.insert(Lib._connections, connection)
        return connection -- :Disconnect() it to stop tracking new objects
    end

    ---------------------------------------------------------------------
    -- 3. Groups (per-player / per-NPC colors)
    ---------------------------------------------------------------------
    local groups = {}
    local groupCache = setmetatable({}, { __mode = "k" })

    local function toSet(list)
        local set = {}
        if type(list) == "table" then
            for _, v in ipairs(list) do set[string.lower(tostring(v))] = true end
        end
        return set
    end

    local function toLowerList(list)
        local out = {}
        if type(list) == "table" then
            for _, v in ipairs(list) do table.insert(out, string.lower(tostring(v))) end
        end
        return out
    end

    local function normalize(list)
        local out = {}
        if type(list) ~= "table" then return out end
        for i, g in ipairs(list) do
            if type(g) == "table" and type(g.Match) == "table" and g.Colors ~= nil then
                local m = g.Match
                table.insert(out, {
                    Name = g.Name or ("Group " .. i),
                    Colors = g.Colors, Label = g.Label,
                    players = toSet(m.Players),
                    names = toSet(m.Names),
                    contains = toLowerList(m.Contains),
                    folders = toSet(m.Folders),
                    attributes = type(m.Attributes) == "table" and m.Attributes or nil,
                    custom = type(m.Custom) == "function" and m.Custom or nil,
                })
            else
                warn("[Twilight] Groups[" .. i .. "] needs a Match table and Colors")
            end
        end
        return out
    end

    local function matches(g, target)
        if target:IsA("Player") then
            if g.players[string.lower(target.Name)] or g.players[string.lower(target.DisplayName)] then
                return true
            end
        else
            local lname = string.lower(target.Name)
            if g.names[lname] then return true end
            for _, text in ipairs(g.contains) do
                if string.find(lname, text, 1, true) then return true end
            end
            if next(g.folders) ~= nil then
                local p = target.Parent
                while p and p ~= game do
                    if g.folders[string.lower(p.Name)] then return true end
                    p = p.Parent
                end
            end
            if g.attributes then
                for attr, value in pairs(g.attributes) do
                    if target:GetAttribute(attr) == value then return true end
                end
            end
        end
        if g.custom then
            local ok, result = pcall(g.custom, target)
            if ok and result then return true end
        end
        return false
    end

    local function pickColor(colors, part, additional, isVisible)
        if typeof(colors) == "Color3" then return colors end -- one color for everything
        if type(colors) ~= "table" then return nil end

        local node = colors[part]
        if typeof(node) == "Color3" then return node end
        if additional and type(node) == "table" then node = node[additional] end
        if typeof(node) == "Color3" then return node end
        if type(node) ~= "table" then return nil end -- { Visible, Invisible }

        local checks = Lib.Settings and Lib.Settings.Checks and Lib.Settings.Checks.Visible
        if checks and checks.Enabled and not isVisible then
            return node.Invisible or node.Visible
        end
        return node.Visible or node.Invisible
    end

    Lib.ColorResolver = function(target, part, additional, isVisible)
        if typeof(target) ~= "Instance" then return nil end
        local group = groupCache[target]
        if group == nil then
            group = false
            for _, g in ipairs(groups) do
                if matches(g, target) then group = g break end
            end
            groupCache[target] = group
        end
        if not group then return nil end
        return pickColor(group.Colors, part, additional, isVisible)
    end

    function Lib:RefreshColors() -- call if names/attributes change after a target was first seen
        table.clear(groupCache)
    end

    local originalSetOptions = Lib.SetOptions
    function Lib:SetOptions(options)
        options = options or {}
        if options.Groups ~= nil then
            groups = normalize(options.Groups)
            table.clear(groupCache)
        end
        local clean = {}
        for k, v in pairs(options) do
            if k ~= "Groups" then clean[k] = v end
        end
        originalSetOptions(self, clean)
    end

    function Lib.BoxEnabled(lib, team, isObject)
    	local e = lib.Settings.Box.Enabled
    	if type(e) == "table" then
            if isObject and e.Objects ~= nil then return e.Objects end
            return e[team] == true
    	end
    	return e == true
    end

    ---------------------------------------------------------------------
    -- 4. Unload fix
---------------------------------------------------------------------
    -- 5. Performance
    ---------------------------------------------------------------------
    local clock = os.clock

    local PERF_DEFAULTS = {
        SkipOffscreen = true,         -- off-screen / out-of-range targets: hide once, then skip
        VisibleCheckInterval = 0.1,   -- seconds between line-of-sight checks per target (0 = every frame)
        SizeInterval = 0.25,          -- seconds between model-size reads
        RadarEvery = 2,               -- radar dots update every Nth frame
        LOD = { { Distance = 150, Every = 2 }, { Distance = 400, Every = 3 } }, -- false = off
    }

    local function perf(key)
        local s = Lib.Settings and Lib.Settings.Performance
        local v = s and s[key]
        if v == nil then return PERF_DEFAULTS[key] end
        return v
    end

    local function jitter(interval)
        return interval * (0.75 + math.random() * 0.5) -- spreads checks over different frames
    end

    -- cached line-of-sight check (true = visible)
    function Lib.VisCheck(esp, root)
        local interval = perf("VisibleCheckInterval")
        local now = clock()
        local due = esp._visNext
        if interval > 0 and due and now < due and esp._visRoot == root then
            return esp._visValue
        end
        local cam = workspace.CurrentCamera
        local visible = #cam:GetPartsObscuringTarget({ cam.CFrame.Position, root.Position }, { root }) == 0
        esp._visValue = visible
        esp._visRoot = root
        esp._visNext = now + jitter(interval)
        return visible
    end

    -- cached object size
    function Lib.ObjSize(esp, obj)
        local now = clock()
        local due = esp._sizeNext
        if due and now < due then return esp._size end
        local size
        if obj:IsA("Model") then size = obj:GetExtentsSize() else size = obj.Size end
        esp._size = size
        esp._sizeNext = now + jitter(perf("SizeInterval"))
        return size
    end

    -- object update loop: skip idle targets, spread far targets over frames, isolate errors
    local frame = 0
    function Lib.UpdateObjects(lib)
        Lib._objActive = true
        local store = lib.ObjectESPs
        if not store or not store.ESPs then return end

        local cam = workspace.CurrentCamera
        local camPos = cam.CFrame.Position
        local maxDist = lib.Settings.MaxDistance
        local skip = perf("SkipOffscreen")
        local lod = perf("LOD")
        frame = frame + 1

        for _, esp in pairs(store.ESPs) do
            local run = true
            local root = esp.rootPart
            if root then
                local pos = root.Position
                local dist = (pos - camPos).Magnitude
                local idle = false
                if skip then
                    local _, onScreen = cam:WorldToViewportPoint(pos)
                    idle = (not onScreen) or dist > maxDist
                end
                if idle then
                    if esp._idle then run = false else esp._idle = true end -- run once to hide
                else
                    esp._idle = false
                    if lod then
                        local every = 1
                        for _, level in ipairs(lod) do
                            if dist >= level.Distance then every = level.Every end
                        end
                        if every > 1 then
                            local phase = esp._phase
                            if not phase then
                                phase = math.random(0, 5)
                                esp._phase = phase
                            end
                            run = (frame + phase) % every == 0
                        end
                    end
                end
            end

            if run then
                local ok, err = pcall(esp.UpdateESP, esp, lib)
                if ok then
                    if esp._errs then esp._errs = nil end
                else
                    local n = (esp._errs or 0) + 1
                    esp._errs = n
                    if n == 1 then warn("[Twilight] object ESP error: " .. tostring(err)) end
                    if n >= 30 then pcall(removeObjectESP, esp, lib) end -- give up on a broken target
                end
            end
        end
    end

    -- players: same skip for off-screen / out-of-range players
    local originalPlayerUpdate = ab.UpdateESP
    ab.UpdateESP = function(self, lib, player)
        Lib._plrActive = true
        if perf("SkipOffscreen") then
            local esp = lib.Drawings.ESP[player]
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if esp and root then
                local cam = workspace.CurrentCamera
                local pos = root.Position
                local _, onScreen = cam:WorldToViewportPoint(pos)
                if (not onScreen) or (pos - cam.CFrame.Position).Magnitude > lib.Settings.MaxDistance then
                    if esp._idle then return end
                    esp._idle = true
                else
                    esp._idle = false
                end
            end
        end
        return originalPlayerUpdate(self, lib, player)
    end

    -- radar dots: every Nth frame, and nothing at all while the radar is off
    local dotState = setmetatable({}, { __mode = "k" })
    function Lib.DotSkip(dot)
        if not Lib.Settings.Radar.Enabled then
            if dotState[dot] ~= -1 then
                dotState[dot] = -1
                pcall(function() dot.Visible = false end)
            end
            return true
        end
        local n = dotState[dot]
        if n == nil or n < 0 then
            dotState[dot] = 0
            return false
        end
        n = n + 1
        if n >= perf("RadarEvery") then
            dotState[dot] = 0
            return false
        end
        dotState[dot] = n
        return true
    end

    -- hide-everything loops: run once when disabled, not every frame (also hides box fills)
    local originalDisablePlayers = Lib.DisablePlayerESP
    local playersHidden = false
    function Lib:DisablePlayerESP()
        if playersHidden and not Lib._plrActive then return end
        playersHidden = true
        Lib._plrActive = false
        originalDisablePlayers(self)
        for _, esp in pairs(Lib.Drawings.ESP or {}) do
            if type(esp) == "table" and type(esp.Fills) == "table" then
                for _, fill in pairs(esp.Fills) do pcall(function() fill.Visible = false end) end
            end
        end
    end

    local originalDisableObjects = Lib.DisableObjectESP
    local objectsHidden = false
    function Lib:DisableObjectESP()
        if objectsHidden and not Lib._objActive then return end
        objectsHidden = true
        Lib._objActive = false
        originalDisableObjects(self)
        local store = Lib.ObjectESPs
        if store and store.ESPs then
            for _, esp in pairs(store.ESPs) do
                if esp.Fills then
                    for _, fill in pairs(esp.Fills) do pcall(function() fill.Visible = false end) end
                end
            end
        end
    end

    ---------------------------------------------------------------------
    -- 6. Marks (one-time colors) and custom names
    ---------------------------------------------------------------------
    local marks = {} -- [target] = { colors = ..., conns = { ... } }

    local function resolveTarget(target)
        if type(target) == "string" then
            local wanted = string.lower(target)
            for _, p in ipairs(Players:GetPlayers()) do
                if string.lower(p.Name) == wanted or string.lower(p.DisplayName) == wanted then
                    return p
                end
            end
            return nil
        end
        if typeof(target) == "Instance" then return target end
        return nil
    end

    local function humanoidOf(target)
        if target:IsA("Player") then
            local character = target.Character
            return character and character:FindFirstChildOfClass("Humanoid")
        end
        return target:FindFirstChildOfClass("Humanoid")
    end

    function Lib:Unmark(target)
        target = resolveTarget(target)
        local entry = target and marks[target]
        if not entry then return false end
        marks[target] = nil
        for _, c in ipairs(entry.conns) do pcall(function() c:Disconnect() end) end
        return true
    end

    function Lib:ClearMarks()
        local list = {}
        for target in pairs(marks) do table.insert(list, target) end
        for _, target in ipairs(list) do Lib:Unmark(target) end
    end

    function Lib:IsMarked(target)
        target = resolveTarget(target)
        return target ~= nil and marks[target] ~= nil
    end

    -- Lib:Mark(target, colors, untilMode)
    --   target:    Player, player name (string), Model or Part
    --   colors:    Color3 or a ColorSet (same format as Groups.Colors); default red
    --   untilMode: "Forever" (default), "Death" (until Humanoid health hits 0), or a number of seconds
    function Lib:Mark(target, colors, untilMode)
        local resolved = resolveTarget(target)
        if not resolved then
            warn("[Twilight] Mark: target not found: " .. tostring(target))
            return false
        end
        target = resolved
        if colors == nil then colors = Color3.fromRGB(255, 60, 60) end
        if untilMode == nil then untilMode = "Forever" end

        Lib:Unmark(target) -- marking again replaces the old mark
        local entry = { colors = colors, conns = {} }
        marks[target] = entry

        local function expire()
            if marks[target] == entry then Lib:Unmark(target) end
        end

        -- the target left the game: drop the mark
        if target:IsA("Player") then
            table.insert(entry.conns, Players.PlayerRemoving:Connect(function(p)
                if p == target then expire() end
            end))
        else
            table.insert(entry.conns, target.Destroying:Connect(expire))
            table.insert(entry.conns, target.AncestryChanged:Connect(function()
                if not target:IsDescendantOf(workspace) then expire() end
            end))
        end

        if untilMode == "Death" then
            local function watchHumanoid(humanoid)
                if not humanoid then return end
                if humanoid.Health <= 0 then expire() return end
                table.insert(entry.conns, humanoid.HealthChanged:Connect(function(health)
                    if health <= 0 then expire() end
                end))
                table.insert(entry.conns, humanoid.Died:Connect(expire))
            end

            watchHumanoid(humanoidOf(target))
            if target:IsA("Player") then
                table.insert(entry.conns, target.CharacterAdded:Connect(function(character)
                    watchHumanoid(character:WaitForChild("Humanoid", 5))
                end))
            elseif not humanoidOf(target) then
                warn("[Twilight] Mark: '" .. target.Name .. "' has no Humanoid, so \"Death\" can't be detected")
            end
        elseif type(untilMode) == "number" then
            task.delay(untilMode, expire)
        elseif untilMode ~= "Forever" then
            warn("[Twilight] Mark: unknown Until value, using \"Forever\"")
        end
        return true
    end

    -- marks win over Groups; parts a mark doesn't cover fall through to Groups / normal colors
    local baseResolver = Lib.ColorResolver
    Lib.ColorResolver = function(target, part, additional, isVisible)
        local entry = marks[target]
        if entry then
            local color = pickColor(entry.colors, part, additional, isVisible)
            if color then return color end
        end
        return baseResolver(target, part, additional, isVisible)
    end

    -- custom names for objects: SetName > Groups Label > real name
    local customNames = setmetatable({}, { __mode = "k" })
    local labelCache = setmetatable({}, { __mode = "k" })

    local function groupFor(target)
        local group = groupCache[target]
        if group == nil then
            group = false
            for _, g in ipairs(groups) do
                if matches(g, target) then group = g break end
            end
            groupCache[target] = group
        end
        return group
    end

    local function expand(text, obj)
        return (string.gsub(text, "{name}", function() return obj.Name end))
    end

    function Lib.NameOf(obj)
        local label = customNames[obj]
        if label == nil then
            local group = groupFor(obj)
            label = group and group.Label
        end
        if label == nil or label == false then return obj.Name end

        if type(label) == "function" then
            local ok, result = pcall(label, obj)
            if ok and result ~= nil then return tostring(result) end
            return obj.Name
        end

        local cached = labelCache[obj]
        if not cached or cached[1] ~= label then
            cached = { label, expand(tostring(label), obj) }
            labelCache[obj] = cached
        end
        return cached[2]
    end

    function Lib:SetName(object, label) -- label: string, function(obj) -> string, or nil to clear
        customNames[object] = label
        labelCache[object] = nil
    end

    local baseRefresh = Lib.RefreshColors
    function Lib:RefreshColors()
        baseRefresh(self)
        table.clear(labelCache)
    end

    ---------------------------------------------------------------------
    -- 7. Per-target options, object colors, health bar + distance colors
    ---------------------------------------------------------------------
    -- Enabled.Objects overrides Enabled.generic for NPCs/objects (Chams, Name, Tracer, HealthBar, Distance)
    function Lib.FeatureOn(lib, feature, team)
        local enabled = lib.Settings[feature].Enabled
        local objects = enabled.Objects
        if objects ~= nil then return objects end
        return enabled[team]
    end

    -- Box.Style: a number, or { Players = ..., Objects = ... }
    function Lib.BoxStyle(lib, isObject)
        local style = lib.Settings.Box.Style
        if type(style) == "table" then
            if isObject then return style.Objects or style.Players or 1 end
            return style.Players or style.Objects or 1
        end
        return style
    end

    -- base colors for NPCs/objects (same slot names as Groups.Colors)
    Lib.ObjectColors = Lib.ObjectColors or {}

    -- distance text color: marks/groups/ObjectColors, then currentColors.<team>.Distance, then the Text color
    local utilities = a.b()
    function Lib.DistColor(lib, target, visible, textColor)
        local who = target
        if type(target) == "table" then who = target.Object end
        if who ~= nil then
            local ok, color = pcall(lib.ColorResolver, who, "Distance", nil, visible)
            if ok and typeof(color) == "Color3" then return color end
        end
        local team = "generic"
        if typeof(target) == "Instance" and target:IsA("Player") then
            local ok, result = pcall(utilities.GetPlayerType, utilities, target)
            if ok and result then team = result end
        end
        local set = lib.Settings.currentColors[team]
        local base = set and set.Distance
        if typeof(base) == "Color3" then return base end
        return textColor
    end

    -- health bar colors for marks / groups / ObjectColors
    -- format: HealthBar = { Outline = Color3, Fills = { High = Color3, Medium = Color3, Low = Color3 } }
    local function healthStatus(target)
        local humanoid
        if target:IsA("Player") then
            local character = target.Character
            humanoid = character and character:FindFirstChildOfClass("Humanoid")
        else
            humanoid = target:FindFirstChildOfClass("Humanoid")
        end
        if not humanoid or humanoid.MaxHealth <= 0 then return nil end
        local ratio = humanoid.Health / humanoid.MaxHealth
        if ratio > 0.65 then return "High" end
        if ratio > 0.2 then return "Medium" end
        return "Low"
    end

    local function healthColor(set, target, additional)
        if type(set) ~= "table" then return nil end
        local bar = set.HealthBar
        if type(bar) ~= "table" then return nil end
        if additional == "Outline" then
            if typeof(bar.Outline) == "Color3" then return bar.Outline end
            return nil
        end
        local fills = bar.Fills
        if type(fills) ~= "table" then return nil end
        local status = healthStatus(target)
        local color = status and fills[status]
        if typeof(color) == "Color3" then return color end
        return nil
    end

    -- final resolver order: marks > groups > ObjectColors (objects only) > normal team colors
    local layeredResolver = Lib.ColorResolver
    Lib.ColorResolver = function(target, part, additional, isVisible)
        if typeof(target) ~= "Instance" then return nil end
        local isPlayer = target:IsA("Player")

        if part == "HealthBar" then
            local entry = marks[target]
            local color = entry and healthColor(entry.colors, target, additional)
            if color then return color end
            local group = groupFor(target)
            color = group and healthColor(group.Colors, target, additional)
            if color then return color end
            if not isPlayer then return healthColor(Lib.ObjectColors, target, additional) end
            return nil
        end

        local color = layeredResolver(target, part, additional, isVisible)
        if color ~= nil then return color end
        if not isPlayer then
            return pickColor(Lib.ObjectColors, part, additional, isVisible)
        end
        return nil
    end

    -- SetOptions({ ObjectColors = { ... } }) merges slot by slot
    local previousSetOptions = Lib.SetOptions
    function Lib:SetOptions(options)
        options = options or {}
        if type(options.ObjectColors) == "table" then
            for slot, value in pairs(options.ObjectColors) do Lib.ObjectColors[slot] = value end
        end
        local clean = {}
        for k, v in pairs(options) do
            if k ~= "ObjectColors" then clean[k] = v end
        end
        return previousSetOptions(self, clean)
    end

    ---------------------------------------------------------------------
    -- 8. Simple UI API
    ---------------------------------------------------------------------
    local PLAYER_TEAMS = { "enemy", "friendly", "generic" } -- your own "local" ESP stays off
    local PLAYER_FEATURES = { Chams = true, Box = true, HealthBar = true, Name = true, Tracer = true, Distance = true, Skeleton = true }
    local MONSTER_FEATURES = { Chams = true, Box = true, HealthBar = true, Name = true, Tracer = true, Distance = true }

    -- the per-target switches are created the first time they're needed, starting from your current settings
    local function ensure()
        local s = Lib.Settings
        local box = s.Box
        if type(box.Enabled) ~= "table" then
            local on = box.Enabled == true
            box.Enabled = { enemy = on, friendly = on, generic = on, ["local"] = on, Objects = on }
        end
        if box.Enabled.Objects == nil then box.Enabled.Objects = box.Enabled.generic == true end
        if type(box.Style) ~= "table" then
            local style = box.Style or 1
            box.Style = { Players = style, Objects = style }
        end
        for _, feature in ipairs({ "Chams", "Name", "Tracer", "HealthBar", "Distance" }) do
            local enabled = s[feature].Enabled
            if enabled.Objects == nil then enabled.Objects = enabled.generic == true end
        end
    end

    local function both(item, c) item.Visible = c item.Invisible = c end

    function Lib:SetPlayers(feature, value)
        if not PLAYER_FEATURES[feature] then
            warn("[Twilight] SetPlayers: unknown feature '" .. tostring(feature) .. "'")
            return false
        end
        ensure()
        value = value and true or false
        local enabled = Lib.Settings[feature].Enabled
        for _, team in ipairs(PLAYER_TEAMS) do enabled[team] = value end
        if feature == "HealthBar" and value then
            Lib.Settings.HealthBar.Bar = true
            Lib.Settings.HealthBar.Text = true
        end
        return true
    end

    function Lib:SetMonsters(feature, value)
        if not MONSTER_FEATURES[feature] then
            warn("[Twilight] SetMonsters: unknown feature '" .. tostring(feature) .. "'")
            return false
        end
        ensure()
        value = value and true or false
        Lib.Settings[feature].Enabled.Objects = value
        if feature == "HealthBar" and value then
            Lib.Settings.HealthBar.Bar = true
            Lib.Settings.HealthBar.Text = true
        end
        return true
    end

    function Lib:SetBoxStyle(who, style) -- who: "Players" | "Monsters"; style: "Normal" | "CornerBoxes" | "3D"
        ensure()
        local value = type(style) == "number" and style or Lib.Enums.BoxStyle[style]
        if not value then
            warn("[Twilight] SetBoxStyle: unknown style '" .. tostring(style) .. "'")
            return false
        end
        if who == "Players" then
            Lib.Settings.Box.Style.Players = value
        elseif who == "Monsters" then
            Lib.Settings.Box.Style.Objects = value
        else
            warn("[Twilight] SetBoxStyle: who must be \"Players\" or \"Monsters\"")
            return false
        end
        return true
    end

    local function setHealth(container, level, color)
        container.HealthBar = container.HealthBar or {}
        local bar = container.HealthBar
        if level == "Outline" then
            bar.Outline = color
        elseif level == "High" or level == "Medium" or level == "Low" then
            bar.Fills = bar.Fills or {}
            bar.Fills[level] = color
        else
            warn("[Twilight] SetColor: for Health, level must be \"High\", \"Medium\", \"Low\" or \"Outline\"")
            return false
        end
        return true
    end

    local specific = {} -- [lowercase player name] = colors
    local function nameKey(target)
        if typeof(target) == "Instance" then return string.lower(target.Name) end
        return string.lower(tostring(target))
    end

    -- Lib:SetColor(target, slot, color, level)
    --   target: "Players", "Monsters", or a player (name or Player) for a specific player
    --   slot:   "Box" "Chams" "Names" "Distance" "Tracer" "Skeleton" "Health"
    --   level:  only for "Health": "High" "Medium" "Low" "Outline"
    function Lib:SetColor(target, slot, color, level)
        if typeof(color) ~= "Color3" then
            warn("[Twilight] SetColor: color must be a Color3")
            return false
        end

        if target == "Players" then
            local ok = true
            for _, team in ipairs(PLAYER_TEAMS) do
                local s = Lib.Settings.currentColors[team]
                if slot == "Box" then both(s.Box.Outline, color) both(s.Box.Fill, color)
                elseif slot == "Chams" then both(s.Chams.Outline, color) both(s.Chams.Fill, color)
                elseif slot == "Names" then s.Text = color
                elseif slot == "Distance" then s.Distance = color
                elseif slot == "Tracer" then both(s.Tracer, color)
                elseif slot == "Skeleton" then both(s.Skeleton, color)
                elseif slot == "Health" then ok = setHealth(s, level, color)
                else
                    warn("[Twilight] SetColor: unknown slot '" .. tostring(slot) .. "'")
                    return false
                end
            end
            return ok
        end

        if target == "Monsters" then
            local o = Lib.ObjectColors
            if slot == "Box" or slot == "Chams" or slot == "Tracer" or slot == "Distance" then
                o[slot] = color
            elseif slot == "Names" then
                o.Text = color
            elseif slot == "Health" then
                return setHealth(o, level, color)
            else
                warn("[Twilight] SetColor: unknown slot '" .. tostring(slot) .. "'")
                return false
            end
            return true
        end

        -- a specific player
        if target == nil then
            warn("[Twilight] SetColor: no player selected")
            return false
        end
        if typeof(target) == "Instance" and not target:IsA("Player") then
            warn("[Twilight] SetColor: for NPCs use \"Monsters\", Groups or Mark")
            return false
        end

        local key = nameKey(target)
        local set = specific[key] or {}
        if slot == "Box" or slot == "Chams" or slot == "Tracer" or slot == "Distance" or slot == "Skeleton" then
            set[slot] = color
        elseif slot == "Names" then
            set.Text = color
        elseif slot == "Health" then
            if not setHealth(set, level, color) then return false end
        else
            warn("[Twilight] SetColor: unknown slot '" .. tostring(slot) .. "'")
            return false
        end
        specific[key] = set

        local player = resolveTarget(target)
        if player then
            local entry = marks[player]
            if not entry or entry.colors ~= set then Lib:Mark(player, set, "Forever") end
        end
        return true
    end

    -- Lib:ClearColor(player)        removes all of that player's colors
    -- Lib:ClearColor(player, slot)  removes one slot ("Box", "Names", "Health", ...)
    function Lib:ClearColor(target, slot)
        local key = nameKey(target)
        local set = specific[key]
        if not set then return false end
        if slot == nil then
            specific[key] = nil
            local player = resolveTarget(target)
            if player then Lib:Unmark(player) end
        elseif slot == "Names" then
            set.Text = nil
        elseif slot == "Health" then
            set.HealthBar = nil
        else
            set[slot] = nil
        end
        return true
    end

    -- specific-player colors come back when that player rejoins
    table.insert(Lib._connections, Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        for key, set in pairs(specific) do
            if string.lower(p.Name) == key or string.lower(p.DisplayName) == key then
                Lib:Mark(p, set, "Forever")
            end
        end
    end))

    ---------------------------------------------------------------------
    local originalUnload = Lib.Unload
    function Lib:Unload()
        local store = Lib.ObjectESPs
        if store and store.ESPs then
            for _, esp in pairs(store.ESPs) do pcall(removeObjectESP, esp, Lib) end
        end
        Lib.Drawings.ObjectESPs = Lib.Drawings.ObjectESPs or {} -- the library loops over this and it doesn't exist
        return originalUnload(self)
    end
end

return ah
